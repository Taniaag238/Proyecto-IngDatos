POSTGRES_USER=ventas_app
POSTGRES_PASSWORD=
POSTGRES_DATABASE=ventas_operaciones

MONGO_URI=mongodb://localhost:27018
MONGO_DATABASE=ventas_eventos

SIMULADOR_API_KEY=REEMPLAZAR_CON_UNA_CLAVE_SEGURA
